package templates

templ UsersList(v UsersListView) {
	@Layout(v.Page) {
		<header class="page-header"><h1>Users</h1></header>
		if len(v.Users) == 0 {
			<p class="empty">No users yet.</p>
		} else {
			<table>
				<thead><tr><th>Login</th><th>Email</th><th>Role</th><th>Last seen</th><th></th></tr></thead>
				<tbody>
					for _, u := range v.Users {
						<tr>
							<td>{ u.GitHubLogin }</td>
							<td>{ u.Email }</td>
							<td>{ u.Role }</td>
							<td>
								if u.LastLoginAt != nil {
									{ FormatTimeAgo(*u.LastLoginAt) }
								} else {
									never
								}
							</td>
							<td>
								<form method="post" action={ templ.URL("/users/" + u.ID + "/role") }>
									<input type="hidden" name="csrf_token" value={ v.Page.CSRFToken }/>
									<select name="role" onchange="this.form.submit()">
										if u.Role == "admin" {
											<option value="admin" selected>admin</option>
											<option value="member">member</option>
										} else {
											<option value="admin">admin</option>
											<option value="member" selected>member</option>
										}
									</select>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}
